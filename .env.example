# Copy to .env and fill in. Never commit .env.

# Telegram bot token from BotFather (required)
BOT_TOKEN=000000000:replace-with-your-bot-token
# Bot username without the @ (required)
BOT_USERNAME=your_bot_username
# Short name of the Mini App registered with BotFather (required)
MINI_APP_NAME=app
# Comma-separated chat IDs the bot may work in (empty = none)
ALLOWED_CHAT_IDS=
# Secret for signing links into the Mini App, at least 32 characters (required)
LINK_SECRET=replace-with-at-least-32-random-characters
# SQLite file
DATABASE_PATH=./data/tripsplitter.db
# Key for receipt reading. Optional: receipt reading is off without it
ANTHROPIC_API_KEY=
# Model ID for receipt reading
RECEIPT_MODEL=claude-sonnet-5
# Model calls for receipt reading per group per day
RECEIPT_DAILY_CAP=30
# HTTP port
PORT=3000
# development | test | production
NODE_ENV=development
# Local screen work only: JSON of a fake Telegram user, e.g. {"id":1,"first_name":"Dev"}.
# Startup fails if this is set while NODE_ENV is production.
DEV_FAKE_USER=
# Public HTTPS base URL. Unset = long polling, set = webhook.
WEBHOOK_URL=
# Secret path segment and header value for the webhook. Required when WEBHOOK_URL is set.
# 16 to 256 characters: letters, digits, _ and -
WEBHOOK_SECRET=
