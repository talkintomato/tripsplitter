# Copy to .env and fill in. Never commit .env.

# Telegram bot token from BotFather (required)
BOT_TOKEN=000000000:replace-with-your-bot-token
# Bot username without the @ (required)
BOT_USERNAME=your_bot_username
# Short name of the Mini App registered with BotFather (required)
MINI_APP_NAME=app
# Comma-separated chat IDs the bot may work in (empty = all groups)
ALLOWED_CHAT_IDS=
# Secret for signing links into the Mini App, at least 32 characters (required)
LINK_SECRET=replace-with-at-least-32-random-characters
# SQLite file
DATABASE_PATH=./data/tripsplitter.db
# Photo files and cached receipts. Blank = photos beside DATABASE_PATH (on the same volume).
PHOTO_DIR=
# Key for receipt reading. Optional: receipt reading is off without it
OPENAI_API_KEY=
# Model ID for receipt reading
RECEIPT_MODEL=gpt-6-luna
# Model calls for receipt reading per group per day
RECEIPT_DAILY_CAP=30
# Model calls across all groups per Singapore day. 0 disables this overall limit.
RECEIPT_GLOBAL_DAILY_CAP=300
# HTTP port
PORT=3000
# development | test | production
NODE_ENV=development
# Local screen work only: JSON of a fake Telegram user, e.g. {"id":1,"first_name":"Dev"}.
# Startup fails if this is set while NODE_ENV is production.
DEV_FAKE_USER=
# Public HTTPS base URL. Unset = long polling, set = webhook.
WEBHOOK_URL=
# Secret path segment and header value for the webhook. Required when WEBHOOK_URL is set.
# 16 to 256 characters: letters, digits, _ and -
WEBHOOK_SECRET=

# Blank AGENT_ENABLED follows whether OPENAI_API_KEY is set.
AGENT_ENABLED=
AGENT_MODEL=gpt-6-luna
AGENT_DAILY_CAP=100
AGENT_GLOBAL_DAILY_CAP=1000

# MCP server at /mcp, for AI clients such as Claude. People connect a client through the bot.
MCP_ENABLED=false
MCP_DAILY_CAP_PER_CONNECTION=300

# Look up names only for locations people choose to tag.
PLACE_LOOKUP=true
